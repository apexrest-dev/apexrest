page 10 (
    name: Customers
    alias: CUSTOMERS
    title: Customers
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    region application-marker (
        name: Customer workspace
        type: staticContent
        source {
            htmlCode: <div data-testid="apexrest-crm">Customer workspace</div>
        }
        layout {
            sequence: 5
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )
    region customers (
        name: Customers
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select id, name, email, status from apexrest_customers
                ```
        }
        layout {
            sequence: 10
            slot: BODY
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: customers_report
        }
        link {
            linkColumn: customTarget
            target: {
                page: 80
                items: {
                    P80_ID: #ID#
                }
                clearCache: 80
            }
            linkIcon: <span role="img" aria-label="Edit customer" class="fa fa-edit" title="Edit customer"></span>
        }
        column ID (
            type: hidden
            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: number
            }
        )
        column NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 20
            }
            source {
                dataType: varchar2
            }
        )
        column EMAIL (
            type: plainText
            heading {
                heading: Email
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
        )
        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
        )
        savedReport 100010 (
            visibility: primaryDefault
            displayColumn NAME (
                sequence: 1
            )
            displayColumn EMAIL (
                sequence: 2
            )
            displayColumn STATUS (
                sequence: 3
            )
        )
    )
    button create-customer (
        buttonName: CREATE_CUSTOMER
        label: Create Customer
        layout {
            sequence: 10
            region: @customers
            slot: RIGHT_OF_IR_SEARCH_BAR
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
            hot: true
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 80
                clearCache: 80
            }
        }
    )
    dynamicAction refresh-customers (
        name: Refresh Customers
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @customers
        }
        action refresh-customers-report (
            action: refresh
            affectedElements {
                selectionType: region
                region: @customers
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
