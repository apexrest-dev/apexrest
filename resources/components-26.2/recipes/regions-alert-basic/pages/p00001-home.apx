page 1 (
    name: Home
    alias: HOME
    title: Home
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region app-name (
        name: Home
        title: &APP_TITLE.
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

    region alert-region (
        name: Alert Region
        type: staticContent
        source {
            htmlCode: Region Body
        }
        layout {
            sequence: 140
            slot: body
        }
        appearance {
            template: @/alert
            templateOptions: [
                #DEFAULT#
                t-Alert--defaultIcons
                t-Alert--warning
                t-Alert--horizontal
            ]
        }
        accessibility {
            landmarkLabel: Default Example
        }
        advanced {
            htmlDomId: AlertDemo1
        }
    )

)
