page 2 (
    name: Close on the client
    alias: DIALOG
    title: Close on the client
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/modal-dialog
        templateOptions: #DEFAULT#
    }
    dialog {
        chained: false
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    region dialog-body (
        name: Dialog body
        type: staticContent
        source {
            htmlCode: <p>Done closes this dialog; the parent report refreshes when the dialog-closed event reaches its region.</p>
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )
    region dialog-buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: [
                #DEFAULT#
                t-ButtonRegion--noUI
            ]
        }
    )
    pageItem P2_NOTE (
        type: textField
        label {
            label: Note
        }
        layout {
            sequence: 10
            region: @dialog-body
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )
    button done (
        buttonName: DONE
        label: Done
        layout {
            sequence: 10
            region: @dialog-buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: definedByDynamicAction
        }
    )
    dynamicAction close-dialog (
        name: Close dialog
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @done
        }
        action native-dialog-close (
            action: closeDialog
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
