page 1 (
    name: Debounce and throttle execution
    alias: HOME
    title: Debounce and throttle execution
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    region controls (
        name: Controls
        type: staticContent
        source {
            htmlCode: <p>Type in the text area. Each display item is updated by its own keyup dynamic action: immediately, with a 2000 ms debounce (delayed or immediate), or with a 2000 ms throttle (delayed or immediate).</p>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )
    pageItem P1_TEXT (
        type: textarea
        label {
            label: Enter text here
        }
        layout {
            sequence: 10
            region: @controls
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )
    pageItem P1_IMMEDIATE (
        type: displayOnly
        label {
            label: Immediate
        }
        layout {
            sequence: 20
            region: @controls
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )
    pageItem P1_DEBOUNCE_DELAY (
        type: displayOnly
        label {
            label: Debounce delay
        }
        layout {
            sequence: 30
            region: @controls
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )
    pageItem P1_DEBOUNCE_IMMEDIATE (
        type: displayOnly
        label {
            label: Debounce immediate
        }
        layout {
            sequence: 40
            region: @controls
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )
    pageItem P1_THROTTLE_IMMEDIATE (
        type: displayOnly
        label {
            label: Throttle immediate
        }
        layout {
            sequence: 50
            region: @controls
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )
    pageItem P1_THROTTLE_DELAY (
        type: displayOnly
        label {
            label: Throttle delay
        }
        layout {
            sequence: 60
            region: @controls
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )
    dynamicAction update-immediate (
        name: Update P1_IMMEDIATE
        execution {
            sequence: 10
        }
        when {
            event: keyup
            selectionType: items
            items: P1_TEXT
        }
        action set-item-value (
            name: Set item value
            action: setValue
            settings {
                type: jsExpression
                jsExpression: this.triggeringElement.value
            }
            affectedElements {
                selectionType: items
                items: P1_IMMEDIATE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
    dynamicAction update-debounce-delay (
        name: Update P1_DEBOUNCE_DELAY
        execution {
            sequence: 20
            type: debounce
            time: 2000
        }
        when {
            event: keyup
            selectionType: items
            items: P1_TEXT
        }
        action set-item-value (
            name: Set item value
            action: setValue
            settings {
                type: jsExpression
                jsExpression: this.triggeringElement.value
            }
            affectedElements {
                selectionType: items
                items: P1_DEBOUNCE_DELAY
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
    dynamicAction update-debounce-immediate (
        name: Update P1_DEBOUNCE_IMMEDIATE
        execution {
            sequence: 30
            type: debounce
            time: 2000
            immediate: true
        }
        when {
            event: keyup
            selectionType: items
            items: P1_TEXT
        }
        action set-item-value (
            name: Set item value
            action: setValue
            settings {
                type: jsExpression
                jsExpression: this.triggeringElement.value
            }
            affectedElements {
                selectionType: items
                items: P1_DEBOUNCE_IMMEDIATE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
    dynamicAction update-throttle-immediate (
        name: Update P1_THROTTLE_IMMEDIATE
        execution {
            sequence: 40
            type: throttle
            time: 2000
            immediate: true
        }
        when {
            event: keyup
            selectionType: items
            items: P1_TEXT
        }
        action set-item-value (
            name: Set item value
            action: setValue
            settings {
                type: jsExpression
                jsExpression: this.triggeringElement.value
            }
            affectedElements {
                selectionType: items
                items: P1_THROTTLE_IMMEDIATE
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
    dynamicAction update-throttle-delay (
        name: Update P1_THROTTLE_DELAY
        execution {
            sequence: 50
            type: throttle
            time: 2000
        }
        when {
            event: keyup
            selectionType: items
            items: P1_TEXT
        }
        action set-item-value (
            name: Set item value
            action: setValue
            settings {
                type: jsExpression
                jsExpression: this.triggeringElement.value
            }
            affectedElements {
                selectionType: items
                items: P1_THROTTLE_DELAY
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
