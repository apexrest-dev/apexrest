page 1 (
    name: Conditional field editing
    alias: HOME
    title: Conditional field editing
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    region controls (
        name: Controls
        type: staticContent
        source {
            htmlCode: <p>Enter a controlling value to enable editing; clear it to disable the result.</p>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )
    pageItem P1_INPUT (
        type: textField
        label {
            label: Input
        }
        layout {
            sequence: 10
            region: @controls
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )
    pageItem P1_OUTPUT (
        type: textField
        label {
            label: Result
        }
        layout {
            sequence: 20
            region: @controls
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )
    dynamicAction respond (
        name: Respond to input
        execution {
            sequence: 10

        }
        when {
            event: change
            selectionType: items
            items: P1_INPUT
        }
        clientSideCondition {
            type: itemIsNotNull
            item: P1_INPUT
        }
        action step-10 (
            action: enable
            affectedElements {
                selectionType: items
                items: P1_OUTPUT
            }
            execution {
                sequence: 10
                fireOnInit: true
            }
        )
        action step-20 (
            action: disable
            affectedElements {
                selectionType: items
                items: P1_OUTPUT
            }
            execution {
                sequence: 20
                fireOnInit: true
                fireWhenEventResultIs: false
            }
        )
    )
)
