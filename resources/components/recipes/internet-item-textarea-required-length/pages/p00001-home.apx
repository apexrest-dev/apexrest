page 1 (
    name: Text Area with Length Limit
    alias: HOME
    title: Text Area with Length Limit
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    region form (
        name: Form
        type: staticContent
        source {
            htmlCode: <p>A required comment with a maximum length and a character counter.</p>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )
    pageItem P1_COMMENT (
        type: textarea
        label {
            label: Comment
            alignment: left
        }
        layout {
            sequence: 10
            region: @form
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/required
            templateOptions: #DEFAULT#
            valuePlaceholder: Describe the change in up to 200 characters
        }
        settings {
            charCounter: true
            autoHeight: true
        }
        validation {
            valueRequired: true
            maxLength: 200
        }
    )
)
