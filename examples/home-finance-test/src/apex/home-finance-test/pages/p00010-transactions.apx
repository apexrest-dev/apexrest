page 10 (
    name: Transactions
    alias: TRANSACTIONS
    title: Transactions
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    region r1 (
        name: "Transactions — positive income, negative expenses"
        type: interactiveGrid
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery: select transaction_id, transaction_date, description, category, currency_code, amount from hf_transactions
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
            ]
        }
        pagination {
            type: page
        }
        toolbar {
            controls: [
                searchCol
                searchField
                actionsMenu
                resetButton
                saveButton
            ]
        }
        column APEX$ROW_ACTION (
            type: actionsMenu
            layout {
                sequence: 10
            }
        )
        column APEX$ROW_SELECTOR (
            type: rowSelector
            layout {
                sequence: 20
            }
        )
        column TRANSACTION_ID (
            type: hidden
            layout {
                sequence: 30
            }
            source {
                databaseColumn: TRANSACTION_ID
                dataType: number
                primaryKey: true
            }
        )
        column TRANSACTION_DATE (
            type: datePickerJquery
            heading {
                heading: Date
            }
            settings {
                navigationListFor: month
            }
            layout {
                sequence: 40
            }
            source {
                databaseColumn: TRANSACTION_DATE
                dataType: date
            }
        )
        column DESCRIPTION (
            type: textField
            heading {
                heading: Description
            }
            layout {
                sequence: 50
            }
            validation {
                maxLength: 200
            }
            source {
                databaseColumn: DESCRIPTION
                dataType: varchar2
            }
        )
        column CATEGORY (
            type: selectList
            heading {
                heading: Category
            }
            layout {
                sequence: 60
            }
            source {
                databaseColumn: CATEGORY
                dataType: varchar2
            }
            lov {
                type: sqlQuery
                sqlQuery: select category d, category r from (select 'Income' category from dual union all select 'Housing' from dual union all select 'Food' from dual union all select 'Utilities' from dual union all select 'Transport' from dual union all select 'Leisure' from dual union all select 'Insurance' from dual union all select 'Health' from dual union all select 'Other' from dual) order by 1
            }
            columnFilter {
                lovType: useLov
            }
        )
        column CURRENCY_CODE (
            type: selectList
            heading {
                heading: Currency
            }
            layout {
                sequence: 65
            }
            source {
                databaseColumn: CURRENCY_CODE
                dataType: varchar2
            }
            lov {
                type: sqlQuery
                sqlQuery: select currency_code || ' - ' || currency_name d, currency_code r from hf_currencies order by currency_code
            }
            default {
                type: static
                staticValue: EUR
            }
            columnFilter {
                lovType: useLov
            }
        )
        column AMOUNT (
            type: numberField
            heading {
                heading: "Amount"
                alignment: end
            }
            settings {
                numberAlignment: end
                virtualKeyboard: text
            }
            layout {
                sequence: 70
                columnAlignment: end
            }
            source {
                databaseColumn: AMOUNT
                dataType: number
            }
        )
        savedReport 10101 (
            visibility: primary
            view {
                default: grid
                rowsPerPage: 25
            }
            singleRowView {
                displayedColumns: true
            }
            displayColumn (
                column: @APEX$ROW_ACTION
                layout {
                    sequence: 1
                }
            )
            displayColumn (
                column: @TRANSACTION_DATE
                layout {
                    sequence: 2
                }
            )
            displayColumn (
                column: @DESCRIPTION
                layout {
                    sequence: 3
                }
            )
            displayColumn (
                column: @CATEGORY
                layout {
                    sequence: 4
                }
            )
            displayColumn (
                column: @CURRENCY_CODE
                layout {
                    sequence: 5
                }
            )
            displayColumn (
                column: @AMOUNT
                layout {
                    sequence: 6
                }
            )
        )
    )
    process save-transactions (
        name: "Save Transactions"
        type: interactiveGridAutoRowProcessing
        editableRegion: @r1
        execution {
            sequence: 10
            point: afterSubmit
        }
        advanced {
            executionMappingIdentifier: 16250000000000010001
        }
        target {
            targetType: regionSource
            returnPksAfterInsert: true
        }
        lockRow {
            preventLostUpdates: true
            lockRow: true
        }
        error {
            displayLocation: inlineInNotification
        }
    )
)
