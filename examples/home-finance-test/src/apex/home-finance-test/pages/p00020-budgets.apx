page 20 (
    name: "Budgets"
    alias: "BUDGETS"
    title: "Budgets"
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    region r1 (
        name: "Monthly budgets and spending by currency"
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with budgets as (
                    select 'Housing' category, 1600 budget from dual union all
                    select 'Food', 450 from dual union all select 'Utilities', 180 from dual union all
                    select 'Transport', 100 from dual union all select 'Leisure', 200 from dual union all
                    select 'Insurance', 150 from dual union all select 'Health', 150 from dual union all
                    select 'Other', 200 from dual
                ), spending as (
                    select category, currency_code, -sum(amount) spent from hf_transactions
                    where amount < 0
                      and transaction_date >= trunc(sysdate, 'MM')
                      and transaction_date < add_months(trunc(sysdate, 'MM'), 1)
                    group by category, currency_code
                )
                select b.category, 'EUR' currency_code, b.budget, nvl(s.spent, 0) spent,
                       b.budget - nvl(s.spent, 0) remaining, 'Budget set' budget_status
                from budgets b left join spending s on s.category = b.category and s.currency_code = 'EUR'
                union all
                select s.category, s.currency_code, cast(null as number) budget, s.spent,
                       cast(null as number) remaining, 'No budget set' budget_status
                from spending s where s.currency_code <> 'EUR'
                order by currency_code, category
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: "No rows found. Clear filters or add source data."
        }
        link {
            linkColumn: exclude
        }
        column CATEGORY (
            type: plainText
            heading {
                heading: "Category"
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
            accessibility {
                valueIdentifiesRow: true
            }
        )
        column BUDGET (
            type: plainText
            heading {
                heading: "Budget"
            }
            layout {
                sequence: 2
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )
        column SPENT (
            type: plainText
            heading {
                heading: "Spent"
            }
            layout {
                sequence: 3
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )
        column REMAINING (
            type: plainText
            heading {
                heading: "Remaining"
            }
            layout {
                sequence: 4
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )
        column CURRENCY_CODE (
            type: plainText
            heading {
                heading: "Currency"
            }
            layout {
                sequence: 5
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: E
            }
        )
        column BUDGET_STATUS (
            type: plainText
            heading {
                heading: "Budget status"
            }
            layout {
                sequence: 6
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: F
            }
        )
        savedReport 1001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 25
            }
            displayColumn CATEGORY (
                sequence: 1
            )
            displayColumn BUDGET (
                sequence: 2
            )
            displayColumn SPENT (
                sequence: 3
            )
            displayColumn REMAINING (
                sequence: 4
            )
            displayColumn BUDGET_STATUS (
                sequence: 6
            )
            displayColumn CURRENCY_CODE (
                sequence: 5
            )
        )
    )
)
