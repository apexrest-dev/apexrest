page 20 (
    name: "Budgets"
    alias: "BUDGETS"
    title: "Budgets"
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    region r1 (
        name: "Monthly budgets (EUR)"
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with transactions as (select 1 transaction_id, trunc(sysdate,'MM') + 0 transaction_date, 'Salary' description, 'Income' category, 4200 amount from dual union all select 2 transaction_id, trunc(sysdate,'MM') + 1 transaction_date, 'Freelance' description, 'Income' category, 650 amount from dual union all select 3 transaction_id, trunc(sysdate,'MM') + 2 transaction_date, 'Rent' description, 'Housing' category, -1450 amount from dual union all select 4 transaction_id, trunc(sysdate,'MM') + 3 transaction_date, 'Groceries' description, 'Food' category, -380 amount from dual union all select 5 transaction_id, trunc(sysdate,'MM') + 4 transaction_date, 'Electricity' description, 'Utilities' category, -95 amount from dual union all select 6 transaction_id, trunc(sysdate,'MM') + 5 transaction_date, 'Internet' description, 'Utilities' category, -45 amount from dual union all select 7 transaction_id, trunc(sysdate,'MM') + 6 transaction_date, 'Train pass' description, 'Transport' category, -65 amount from dual union all select 8 transaction_id, trunc(sysdate,'MM') + 7 transaction_date, 'Dining out' description, 'Leisure' category, -120 amount from dual union all select 9 transaction_id, trunc(sysdate,'MM') + 8 transaction_date, 'Streaming' description, 'Leisure' category, -25 amount from dual union all select 10 transaction_id, trunc(sysdate,'MM') + 9 transaction_date, 'Insurance' description, 'Insurance' category, -110 amount from dual) , budgets as (select 'Housing' category,1600 budget from dual union all select 'Food',450 from dual union all select 'Utilities',180 from dual union all select 'Transport',100 from dual union all select 'Leisure',200 from dual union all select 'Insurance',150 from dual) select b.category,b.budget,-sum(t.amount) spent,b.budget+sum(t.amount) remaining from budgets b join transactions t on t.category=b.category group by b.category,b.budget order by b.category
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        pagination {
            type: rowRangesXToYOfZ
        }
        messages {
            whenNoDataFound: "No rows found. Clear filters or add source data."
        }
        link {
            linkColumn: exclude
        }
        column CATEGORY (
            type: plainText
            heading {
                heading: "Category"
            }
            layout {
                sequence: 1
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
            accessibility {
                valueIdentifiesRow: true
            }
        )
        column BUDGET (
            type: plainText
            heading {
                heading: "Budget"
            }
            layout {
                sequence: 2
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: B
            }
        )
        column SPENT (
            type: plainText
            heading {
                heading: "Spent"
            }
            layout {
                sequence: 3
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: C
            }
        )
        column REMAINING (
            type: plainText
            heading {
                heading: "Remaining"
            }
            layout {
                sequence: 4
            }
            source {
                dataType: number
            }
            advanced {
                endUserAlias: D
            }
        )
        savedReport 1001 (
            visibility: primaryDefault
            view {
                rowsPerPage: 25
            }
            displayColumn CATEGORY (
                sequence: 1
            )
            displayColumn BUDGET (
                sequence: 2
            )
            displayColumn SPENT (
                sequence: 3
            )
            displayColumn REMAINING (
                sequence: 4
            )
        )
    )
)
