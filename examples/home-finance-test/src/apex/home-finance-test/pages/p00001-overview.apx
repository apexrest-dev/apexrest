page 1 (
    name: "Overview"
    alias: "OVERVIEW"
    title: "Overview"
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    region r1 (
        name: "This month by currency"
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                with monthly as (
                    select currency_code,
                           sum(case when amount > 0 then amount else 0 end) income,
                           -sum(case when amount < 0 then amount else 0 end) expenses,
                           sum(amount) available
                    from hf_transactions
                    where transaction_date >= trunc(sysdate, 'MM')
                      and transaction_date < add_months(trunc(sysdate, 'MM'), 1)
                    group by currency_code
                ), active_currencies as (
                    select currency_code from monthly union select 'EUR' from dual
                ), metrics as (
                    select 1 sequence, 'Income' label from dual union all
                    select 2, 'Expenses' from dual union all select 3, 'Available' from dual
                )
                select metrics.label || ' (' || c.currency_code || ')' title,
                       to_char(case metrics.sequence when 1 then nvl(m.income, 0)
                               when 2 then nvl(m.expenses, 0) else nvl(m.available, 0) end,
                               case when c.minor_units = 0 then 'FM999G999G999G990'
                                    else 'FM999G999G999G990D00' end) || ' ' || c.currency_code value
                from active_currencies a join hf_currencies c on c.currency_code = a.currency_code
                left join monthly m on m.currency_code = a.currency_code
                cross join metrics order by c.currency_code, metrics.sequence
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/cards-container
            templateOptions: #DEFAULT#
        }
        title {
            column: TITLE
        }
        body {
            column: VALUE
        }
    )

    region r2 (
        name: "Spending by category and currency (original amounts)"
        type: chart
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        security {
            escapeSpecialChars: true
        }
        chart {
            type: bar
        }
        axis x (
            name: x
            title: "Category"
        )
        axis y (
            name: y
            title: "Amount in labeled currency"
        )
        series values (
            name: "Spending by category and currency (original amounts)"
            execution {
                sequence: 10
            }
            source {
                location: localDatabase
                type: sqlQuery
                sqlQuery:
                    ```sql
                select category || ' (' || currency_code || ')' label, -sum(amount) value
                    from hf_transactions
                    where amount < 0
                      and transaction_date >= trunc(sysdate, 'MM')
                      and transaction_date < add_months(trunc(sysdate, 'MM'), 1)
                    group by category, currency_code order by currency_code, value desc
                    ```
            }
            columnMapping {
                label: LABEL
                value: VALUE
            }
        )
    )
)
