list navigation-menu (
    name: Navigation Menu

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry scaffold-p10 (
        label: "Transactions"
        layout {
            sequence: 20
        }
        link {
            target: {
                page: 10
            }
        }
    )
    entry scaffold-p20 (
        label: "Budgets"
        layout {
            sequence: 30
        }
        link {
            target: {
                page: 20
            }
        }
    )
    entry scaffold-p30 (
        label: "Savings goals"
        layout {
            sequence: 40
        }
        link {
            target: {
                page: 30
            }
        }
    )
)
