{
  "name": "apexrest",
  "version": "1.3.0-beta.1",
  "files": [
    "dist/runtime/",
    "dist/resources/",
    "dist/codex-compat/",
    "README.md",
    "README.uk.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "beta"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apexrest-dev/apexrest-codex.git"
  },
  "description": "Native Codex plugin for Oracle APEX development, deployment and testing",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24 <27"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "apexrest": "dist/runtime/apexrest.mjs"
  },
  "scripts": {
    "prepack": "npm run build",
    "build": "node scripts/build-plugin.mjs",
    "catalog:build": "node scripts/build-component-catalog.mjs",
    "catalog:check": "node scripts/build-component-catalog.mjs --check",
    "catalog:verify": "node scripts/verify-component-recipes.mjs",
    "patterns:build": "node scripts/build-pattern-catalog.mjs",
    "patterns:check": "node scripts/build-pattern-catalog.mjs --check",
    "patterns:capture": "node scripts/capture-pattern-snapshot.mjs",
    "patterns:verify": "node scripts/verify-pattern-recipes.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.base.json",
    "lint": "node scripts/lint.mjs",
    "test:unit": "node scripts/test.mjs unit",
    "test:contracts": "node --test tests/contracts/*.test.mjs",
    "test:packaging": "node --test tests/packaging/*.test.mjs",
    "test:installers": "node scripts/test.mjs installers",
    "test:integration": "node scripts/integration.mjs",
    "site:build": "node scripts/build-site.mjs",
    "release:dry-run": "node scripts/package-release.mjs --dry-run",
    "release:package": "node scripts/package-release.mjs",
    "check-release-readiness": "node scripts/check-release-readiness.mjs",
    "plugin:sync": "npm run build && node scripts/sync-repository-plugin.mjs",
    "plugin:check": "node scripts/sync-repository-plugin.mjs --check",
    "test:repository-plugin": "node scripts/repository-plugin-smoke.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "composer:catalog": "node scripts/build-composer-catalog.mjs",
    "composer:check": "node scripts/build-composer-catalog.mjs --check",
    "composer:verify": "node scripts/verify-composer.mjs",
    "composer:author": "node scripts/composer-author.mjs",
    "composer:benchmark": "node scripts/benchmark-composer.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "tar": "7.5.22",
    "yaml": "2.9.1",
    "yauzl": "3.4.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.10.1",
    "@types/yauzl": "2.10.3",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "fflate": "0.8.3",
    "marked": "18.0.7",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
