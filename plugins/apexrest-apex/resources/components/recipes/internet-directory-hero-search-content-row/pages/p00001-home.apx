page 1 (
    name: Employee Directory Search
    alias: HOME
    title: Employee Directory Search
    appearance {
        pageTemplate: @/standard
        templateOptions: [
            #DEFAULT#
            t-PageBody--noContentPadding
        ]
    }
    css {
        inline:
            ```css
            /* Keep Quick Picks below the search field */
            .t-Form-itemWrapper:has(.apex-quick-picks) {
                flex-wrap: wrap;
            }
            .t-Form-itemWrapper:has(.apex-quick-picks) .apex-quick-picks {
                order: 5;
            }
            .apex-quick-picks {
                margin-block-start: .25rem;
            }
            ```
    }
    navigation {
        warnOnUnsavedChanges: false
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }

    region hero (
        name: Employees
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: [
                #DEFAULT#
                t-HeroRegion--hideIcon
                t-Form--noPadding
                t-Form--large
                t-Form--stretchInputs
            ]
        }
        accessibility {
            landmarkType: search
        }
    )
    region results (
        name: Results
        type: themeTemplateComponent/contentRow
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select e.EMPLOYEE_ID, e.FIRST_NAME, e.LAST_NAME, e.EMAIL, e.COUNTRY, e.GEOGRAPHIC_REGION, e.CITY,
                       e.CAREER_LEVEL, e.JOB_TITLE, e.COST_CENTER, e.DIRECT_REPORTS, e.PHONE_NUMBER, e.TAGS, e.TIME_ZONE,
                       substr(e.LAST_NAME, 1, 1) || substr(e.FIRST_NAME, 1, 1) as INITIALS,
                       e.COUNTRY_CODE
                  from (
                      select 101 EMPLOYEE_ID, 'Ava' FIRST_NAME, 'Moreno' LAST_NAME, 'ava.moreno@example.com' EMAIL, 'Data Engineer' JOB_TITLE, 'Engineering' BUSINESS_UNIT, 'Platform' COST_CENTER, 'ACTIVE' EMPLOYMENT_STATUS, 'HYBRID' WORK_ARRANGEMENT, 'FULL_TIME' EMPLOYMENT_TYPE, date '2021-03-15' HIRE_DATE, 'Spain' COUNTRY, 'es' COUNTRY_CODE, 'Madrid' CITY, 'EMEA' GEOGRAPHIC_REGION, 'L3' CAREER_LEVEL, 'Europe/Madrid' TIME_ZONE, '+34 600 101 101' PHONE_NUMBER, 2 DIRECT_REPORTS, 'Data:Cloud' TAGS from dual union all
                      select 102, 'Liam', 'Okafor', 'liam.okafor@example.com', 'Product Manager', 'Product', 'Growth', 'ACTIVE', 'REMOTE', 'FULL_TIME', date '2019-07-01', 'Nigeria', 'ng', 'Lagos', 'EMEA', 'L4', 'Africa/Lagos', '+234 800 102 102', 4, 'Strategy:Mentor' from dual union all
                      select 103, 'Mia', 'Tanaka', 'mia.tanaka@example.com', 'UX Designer', 'Product', 'Growth', 'LEAVE', 'ONSITE', 'PART_TIME', date '2022-01-10', 'Japan', 'jp', 'Tokyo', 'APAC', 'L2', 'Asia/Tokyo', '+81 90 103 103', 0, 'Design' from dual union all
                      select 104, 'Noah', 'Schmidt', 'noah.schmidt@example.com', 'Data Engineer', 'Engineering', 'Platform', 'ACTIVE', 'ONSITE', 'FULL_TIME', date '2018-11-05', 'Germany', 'de', 'Berlin', 'EMEA', 'L4', 'Europe/Berlin', '+49 151 104 104', 3, 'Data:Mentor' from dual union all
                      select 105, 'Zoe', 'Martin', 'zoe.martin@example.com', 'Account Executive', 'Sales', 'Field Sales', 'INACTIVE', 'REMOTE', 'CONTRACTOR', date '2020-05-20', 'France', 'fr', 'Paris', 'EMEA', 'L2', 'Europe/Paris', '+33 6 105 105', 0, 'Sales' from dual union all
                      select 106, 'Omar', 'Haddad', 'omar.haddad@example.com', 'Support Analyst', 'Operations', 'Service Desk', 'ACTIVE', 'HYBRID', 'FULL_TIME', date '2023-02-27', 'Jordan', 'jo', 'Amman', 'EMEA', 'L1', 'Asia/Amman', '+962 7 106 106', 0, 'Support' from dual union all
                      select 107, 'Iris', 'Novak', 'iris.novak@example.com', 'Account Executive', 'Sales', 'Field Sales', 'ACTIVE', 'HYBRID', 'FULL_TIME', date '2017-09-12', 'United States', 'us', 'New York', 'AMER', 'L3', 'America/New_York', '+1 212 107 107', 5, 'Sales:Mentor' from dual union all
                      select 108, 'Hugo', 'Silva', 'hugo.silva@example.com', 'Support Analyst', 'Operations', 'Service Desk', 'LEAVE', 'REMOTE', 'PART_TIME', date '2024-04-08', 'Brazil', 'br', 'Sao Paulo', 'AMER', 'L1', 'America/Sao_Paulo', '+55 11 108 108', 0, 'Support:Cloud' from dual
                       ) e
                 where :P1_SEARCH is null
                    or instr(lower(e.FIRST_NAME || ' ' || e.LAST_NAME || ' ' || e.EMAIL || ' ' || e.CITY || ' ' || e.COUNTRY),
                             lower(regexp_replace(:P1_SEARCH, '^(email|city|phone):'))) > 0
                    or (regexp_like(:P1_SEARCH, '^(phone:)?[0-9]+$')
                        and e.PHONE_NUMBER like '%' || regexp_replace(:P1_SEARCH, '^phone:') )
                ```
            pageItemsToSubmit: P1_SEARCH
        }
        orderBy {
            type: staticValue
            orderByClause: LAST_NAME, FIRST_NAME
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/blank-with-attributes-no-grid
            templateOptions: #DEFAULT#
        }
        componentAppearance {
            display: report
        }
        settings {
            title: <a href="mailto:&EMAIL!ATTR.">&FIRST_NAME. &LAST_NAME.</a>
            description:
                ```html
                <div class="u-flex u-flex-col u-gap-1">
                  <div>
                    <strong>&JOB_TITLE.</strong>
                    {if ?COST_CENTER/} &middot; &COST_CENTER.{endif/}
                  </div>
                  <div class="u-flex u-flex-wrap u-align-items-center u-gap-x-4 u-gap-y-1">
                    <span class="u-inline-flex u-align-items-center u-gap-2"
                          {if ?TIME_ZONE/}title="Time zone: &TIME_ZONE!ATTR."{endif/}>
                      <span class="fa fa-flag-&COUNTRY_CODE!ATTR." aria-hidden="true"></span>
                      <span>{if ?CITY/}&CITY. &middot; {endif/}&COUNTRY.</span>
                    </span>
                    {if ?EMAIL/}
                      <a href="mailto:&EMAIL!ATTR." class="u-wrap-anywhere">&EMAIL.</a>
                    {endif/}
                    {if ?PHONE_NUMBER/}
                      <span>&PHONE_NUMBER.</span>
                    {endif/}
                  </div>
                </div>
                ```
            displayAvatar: true
            displayBadge: true
        }
        plugin-avatar {
            type: initials
            initials: INITIALS
        }
        plugin-badge {
            label: Direct Reports
            value: DIRECT_REPORTS
            icon: fa-users
            style: subtle
            shape: circular
            size: medium
            columnWidth: small
            position: end
            alignment: end
        }
        pagination {
            type: scroll
            initialEntitiesCount: 30
        }
        messages {
            whenNoDataFound: No search conducted or no results found.
        }

        column EMPLOYEE_ID (
            layout {
                sequence: 10
            }
            source {
                databaseColumn: EMPLOYEE_ID
                dataType: number
                primaryKey: true
            }
        )
        column FIRST_NAME (
            layout {
                sequence: 20
            }
            source {
                databaseColumn: FIRST_NAME
                dataType: varchar2
            }
            accessibility {
                valueIdentifiesRow: true
            }
        )
        column LAST_NAME (
            layout {
                sequence: 30
            }
            source {
                databaseColumn: LAST_NAME
                dataType: varchar2
            }
            accessibility {
                valueIdentifiesRow: true
            }
        )
        column EMAIL (
            layout {
                sequence: 40
            }
            source {
                databaseColumn: EMAIL
                dataType: varchar2
            }
        )
        column COUNTRY (
            layout {
                sequence: 50
            }
            source {
                databaseColumn: COUNTRY
                dataType: varchar2
            }
        )
        column GEOGRAPHIC_REGION (
            layout {
                sequence: 60
            }
            source {
                databaseColumn: GEOGRAPHIC_REGION
                dataType: varchar2
            }
        )
        column CITY (
            layout {
                sequence: 70
            }
            source {
                databaseColumn: CITY
                dataType: varchar2
            }
        )
        column CAREER_LEVEL (
            layout {
                sequence: 80
            }
            source {
                databaseColumn: CAREER_LEVEL
                dataType: varchar2
            }
        )
        column JOB_TITLE (
            layout {
                sequence: 90
            }
            source {
                databaseColumn: JOB_TITLE
                dataType: varchar2
            }
        )
        column COST_CENTER (
            layout {
                sequence: 100
            }
            source {
                databaseColumn: COST_CENTER
                dataType: varchar2
            }
        )
        column DIRECT_REPORTS (
            layout {
                sequence: 110
            }
            source {
                databaseColumn: DIRECT_REPORTS
                dataType: number
            }
        )
        column PHONE_NUMBER (
            layout {
                sequence: 120
            }
            source {
                databaseColumn: PHONE_NUMBER
                dataType: varchar2
            }
        )
        column TAGS (
            layout {
                sequence: 130
            }
            source {
                databaseColumn: TAGS
                dataType: varchar2
            }
        )
        column TIME_ZONE (
            layout {
                sequence: 140
            }
            source {
                databaseColumn: TIME_ZONE
                dataType: varchar2
            }
        )
        column INITIALS (
            layout {
                sequence: 150
            }
            source {
                databaseColumn: INITIALS
                dataType: varchar2
            }
        )
        column COUNTRY_CODE (
            layout {
                sequence: 160
            }
            source {
                databaseColumn: COUNTRY_CODE
                dataType: varchar2
            }
        )

        action details (
            position: primaryActions
            template: button
            label: Details
            layout {
                sequence: 10
            }
            behavior {
                type: redirectUrl
                targetUrl: mailto:&EMAIL.
            }
            appearance {
                displayType: icon
                icon: fa-info-circle-o
            }
        )
    )
    pageItem P1_SEARCH (
        type: textField
        label {
            label: Search
            alignment: left
        }
        settings {
            subtype: search
        }
        layout {
            sequence: 10
            region: @hero
            slot: searchFieldAndSmartFilters
            alignment: left
        }
        appearance {
            template: @/hidden
            templateOptions: #DEFAULT#
            icon: fa-search
            width: 72
            valuePlaceholder: Search by name, email or last digits of phone number
        }
        quickPicks {
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Moreno' d, 'Moreno' r from dual union all
                select 'city:madrid' d, 'city:madrid' r from dual union all
                select 'New York' d, 'New York' r from dual union all
                select 'France' d, 'France' r from dual union all
                select 'email:iris.novak@example.com' d, 'email:iris.novak@example.com' r from dual union all
                select 'phone:104' d, 'phone:104' r from dual
                ```
        }
    )
    dynamicAction search (
        name: Search
        execution {
            sequence: 10
        }
        when {
            selectionType: items
            items: P1_SEARCH
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @results
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
    dynamicAction keydown (
        name: KeyDown
        execution {
            sequence: 30
            type: debounce
            time: 250
        }
        when {
            event: keyup
            selectionType: items
            items: P1_SEARCH
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @results
            }
            execution {
                sequence: 30
                fireOnInit: false
            }
            clientSideCondition {
                type: jsExpression
                javaScriptExpression: $v("P1_SEARCH").length >= 2 || $v("P1_SEARCH").length === 0
            }
        )
    )

)
