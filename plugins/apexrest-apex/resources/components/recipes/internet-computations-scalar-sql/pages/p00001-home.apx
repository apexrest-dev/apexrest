page 1 (
    name: Scalar aggregate from synthetic SQL
    alias: HOME
    title: Scalar aggregate from synthetic SQL
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    region controls (
        name: Controls
        type: staticContent
        source {
            htmlCode: <p>This value is computed before the page header using a side-effect-free computation.</p>
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
    )
    pageItem P1_OUTPUT (
        type: textField
        label {
            label: Computed value
        }
        layout {
            sequence: 10
            region: @controls
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
        }
    )
    computation derive (
        itemName: P1_OUTPUT
        computation {
            type: sqlQuerySingleValue
            sqlQuery:
                ```sql
                select sum(VALUE) from (select 12 VALUE from dual union all select 7 from dual)
                ```
        }
        execution {
            sequence: 10
            point: beforeHeader
        }
    )
)
