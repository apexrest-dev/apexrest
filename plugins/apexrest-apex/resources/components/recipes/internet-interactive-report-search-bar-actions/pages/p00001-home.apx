page 1 (
    name: Report Search Bar Actions
    alias: HOME
    title: Report Search Bar Actions
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }
    region customers (
        name: Customers
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select level CUSTOMER_ID,
                       'Customer ' || level CUSTOMER_NAME,
                       case mod(level, 2) when 0 then 'Retail' else 'Wholesale' end SEGMENT
                  from dual
               connect by level <= 12
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: customers_ir
        }
        column CUSTOMER_ID (
            type: plainText
            heading {
                heading: Customer Id
                alignment: end
            }
            layout {
                sequence: 10
                columnAlignment: end
            }
            source {
                dataType: NUMBER
            }
        )
        column CUSTOMER_NAME (
            type: plainText
            heading {
                heading: Customer
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )
        column SEGMENT (
            type: plainText
            heading {
                heading: Segment
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )
    )
    button create-customer (
        buttonName: CREATE_CUSTOMER
        label: Create
        layout {
            sequence: 10
            region: @customers
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/text-with-icon
            hot: true
            templateOptions: #DEFAULT#
            icon: fa-plus
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 1
                clearCache: 1
            }
        }
    )
    button refresh-customers (
        buttonName: REFRESH_CUSTOMERS
        label: Refresh
        layout {
            sequence: 20
            region: @customers
            slot: rightOfInteractiveReportSearchBar
        }
        appearance {
            buttonTemplate: @/icon
            templateOptions: #DEFAULT#
            icon: fa-refresh
        }
        behavior {
            action: definedByDynamicAction
        }
    )
    dynamicAction refresh-customers-click (
        name: Refresh customers
        execution {
            sequence: 10
        }
        when {
            event: click
            selectionType: button
            button: @refresh-customers
        }
        action refresh-report (
            action: refresh
            affectedElements {
                selectionType: region
                region: @customers
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )
    )
)
