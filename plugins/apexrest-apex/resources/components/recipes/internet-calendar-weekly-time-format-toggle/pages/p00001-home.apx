        }
        serverSideCondition {
            type: item=value
            item: P1_TIME_FORMAT
            value: 24
        }
        settings {
            displayColumn: TITLE
            startDateColumn: START_DATE
            endDateColumn: END_DATE
            pkColumn: ID
            showTime: true
