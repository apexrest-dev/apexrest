            ]
            cssClass: CSS_CLASS
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function( pOptions ) {
                    pOptions.displayEventTime = true;
                    return pOptions;
                }
                ```
        }
    )
    pageItem P1_TIME_FORMAT (
        type: selectList
        label {
            label: Time Format
            alignment: left
        }
        settings {
            pageActionOnSelection: redirectSetValue
        }
        lov {
            type: staticValues
            staticValues: STATIC2:Default (based on NLS);default,12 hour;12,24 hour;24
            displayExtraValues: false
            displayNullValue: false
        }
        appearance {
            template: @/optional-above
            templateOptions: #DEFAULT#
            height: 1
        }
        default {
            type: static
            staticValue: default
        }
        layout {
            sequence: 10
            region: @controls
            slot: regionBody
        }
    )
)
