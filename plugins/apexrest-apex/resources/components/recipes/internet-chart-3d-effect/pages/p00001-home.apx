page 1 (
    name: Bar Chart 3D Effect
    alias: HOME
    title: Bar Chart 3D Effect
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
    }

    region quarterly-revenue (
        name: Quarterly Revenue (3D Effect)
        type: chart
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--scrollBody
            ]
        }
        chart {
            type: bar
        }
        chartLayout {
            height: 380
        }
        legend {
            position: top
        }
        componentAdvanced {
            initJavaScriptFunction:
                ```javascript-browser
                function( options ) {
                    // Add the Oracle JET 3D effect to the existing chart style defaults.
                    options.styleDefaults = $.extend( options.styleDefaults, { threeDEffect: "on", barGapRatio: 0.4 } );
                    return options;
                }
                ```
        }

        series this-year (
            name: This Year
            execution {
                sequence: 10
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 'Q1' as quarter, 182000 as revenue from dual union all
                    select 'Q2', 205000 from dual union all
                    select 'Q3', 198000 from dual union all
                    select 'Q4', 251000 from dual
                    ```
            }
            columnMapping {
                label: QUARTER
                value: REVENUE
            }
        )

        series last-year (
            name: Last Year
            execution {
                sequence: 20
            }
            source {
                type: sqlQuery
                sqlQuery:
                    ```sql
                    select 'Q1' as quarter, 165000 as revenue from dual union all
                    select 'Q2', 171000 from dual union all
                    select 'Q3', 189000 from dual union all
                    select 'Q4', 220000 from dual
                    ```
            }
            columnMapping {
                label: QUARTER
                value: REVENUE
            }
        )

        axis x (
            name: x
            minorTicks {
                show: false
            }
        )

        axis y (
            name: y
            title: Revenue (USD)
            value {
                format: currency
                decimalPlaces: 0
            }
            minorTicks {
                show: false
            }
        )
    )
)
