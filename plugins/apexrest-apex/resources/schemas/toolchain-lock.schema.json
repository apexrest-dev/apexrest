{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "node",
              "java",
              "sqlcl"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "os": {
            "type": "string"
          },
          "arch": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "zip",
              "tar.gz"
            ]
          },
          "executable": {
            "type": "string"
          },
          "allowedHosts": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "license": {
            "type": "string"
          },
          "consentRequired": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "version",
          "url",
          "sha256",
          "os",
          "arch",
          "type",
          "executable",
          "allowedHosts",
          "license",
          "consentRequired"
        ],
        "additionalProperties": false
      }
    },
    "provenance": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    }
  },
  "required": [
    "schemaVersion",
    "artifacts",
    "provenance"
  ],
  "additionalProperties": false
}
