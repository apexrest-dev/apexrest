{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "read": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "oracle-table",
            "oracle-view"
          ]
        },
        "object": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_$#]{0,127}$"
        },
        "key": {
          "minItems": 1,
          "maxItems": 16,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          }
        },
        "keyContract": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "column": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_$#]{0,127}$"
              },
              "type": {
                "type": "string",
                "enum": [
                  "string",
                  "integer",
                  "decimal",
                  "date",
                  "timestamp",
                  "boolean"
                ]
              },
              "nullable": {
                "type": "boolean"
              },
              "maxLength": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "precision": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "scale": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "enum": {
                "maxItems": 100,
                "type": "array",
                "items": {
                  "type": "string",
                  "maxLength": 128,
                  "pattern": "^[^\\x00-\\x1f\\x7f`]*$"
                }
              }
            },
            "required": [
              "column",
              "type",
              "nullable"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "kind",
        "object",
        "key",
        "fields"
      ],
      "additionalProperties": false
    },
    "authorization": {
      "type": "object",
      "properties": {
        "readContract": {
          "type": "string"
        },
        "writeContract": {
          "type": "string"
        }
      },
      "required": [
        "readContract"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "default": {},
      "type": "object",
      "properties": {
        "optimisticLock": {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            }
          },
          "required": [
            "field"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "read",
    "authorization",
    "capabilities"
  ],
  "additionalProperties": false
}
