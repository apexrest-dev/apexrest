page 1 (
    name: Home
    alias: HOME
    title: Home
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region app-name (
        name: Home
        title: &APP_TITLE.
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

    region simple-interactive-report (
        name: Simple Interactive Report
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 'Design review' as task_name, date '2026-01-05' as start_date, 'Open' as status, 'Ada' as assigned_to from dual
                union all select 'Ship release', date '2026-02-10', 'Closed', 'Grace' from dual
                union all select 'Write guide', date '2026-03-02', 'Pending', 'Linus' from dual
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }
        advanced {
            htmlDomId: Demo1
        }
        componentAppearance {
            showNullValuesAs: -
        }
        pagination {
            type: rowRangesXToY
        }
        performance {
            maxRowsToProcess: 1000000
        }
        heading {
            fixedTo: none
        }
        componentAdvanced {
            maxRowsPerPageInSelector: 6
        }
        advanced {
            savedReportMappingIdentifier: 415958145470171602
        }

        column ASSIGNED_TO (
            type: plainText
            heading {
                heading: Assigned to
            }
            layout {
                sequence: 40
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: D
            }
        )

        column START_DATE (
            type: plainText
            heading {
                heading: Start date
            }
            layout {
                sequence: 20
            }
            source {
                dataType: date
            }
            advanced {
                endUserAlias: B
            }
        )

        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 30
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: C
            }
        )

        column TASK_NAME (
            type: plainText
            heading {
                heading: Task name
            }
            layout {
                sequence: 10
            }
            source {
                dataType: varchar2
            }
            advanced {
                endUserAlias: A
            }
        )

        page {
            width: 8.5
            height: 11
            borderWidth: 0.5
            borderColor: #666666
        }
        columnHeadings {
            fontWeight: normal
            backgroundColor: #9bafde
        }
        columns {
            backgroundColor: #efefef
        }

        savedReport 4159599 (
            visibility: primaryDefault
            view {
                rowsPerPage: 50
            }

            displayColumn ASSIGNED_TO (
                sequence: 4
            )

            displayColumn START_DATE (
                sequence: 2
            )

            displayColumn STATUS (
                sequence: 3
            )

            displayColumn TASK_NAME (
                sequence: 1
            )

        )

    )

)
