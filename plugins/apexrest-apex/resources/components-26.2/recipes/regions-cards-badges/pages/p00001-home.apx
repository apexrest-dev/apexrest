page 1 (
    name: Home
    alias: HOME
    title: Home
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region app-name (
        name: Home
        title: &APP_TITLE.
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

    region badges-cards (
        name: Badges Cards
        type: cards
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select 1 as id, 'badge' as category, 'Customer onboarding' as title, 'Team A' as subtitle,
                       'Welcome pack and first call.' as body, 'Due this week' as secondary_body, 'fa-user' as icon_class,
                       'badge' as badge, null as image, '5 January 2026 9:00 AM' as start_date, '10:00 AM' as end_date
                  from dual
                union all
                select 2, 'badge', 'Quarterly review', 'Team B', 'Revenue and pipeline.', 'Next month', 'fa-line-chart',
                       'badge', null, '2 February 2026 2:00 PM', '3:00 PM'
                  from dual
                ```
        }
        layout {
            sequence: 10
            slot: body
            columnSpan: 8
            columnCssClasses: col-sm-12
        }
        appearance {
            template: @/cards-container
            templateOptions: [
                #DEFAULT#
                t-CardsRegion--styleB
            ]
        }
        componentAppearance {
            gridColumns: 3
        }
        card {
            primaryKeyColumn1: ID
        }
        title {
            column: TITLE
        }
        iconAndBadge {
            iconSource: imageUrl
            imageUrl: &IMAGE.
            iconDescription: &TITLE.
            badgeColumn: SUBTITLE
        }

        action action (
            type: fullCard
            layout {
                sequence: 10
            }
            behavior {
                type: redirectUrl
                targetUrl: #
            }
        )

    )

)
