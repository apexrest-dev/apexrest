#!/bin/bash

# Bridge between the APEXREST Omarchy panel and the apexrest CLI.
#
# The panel never builds shell strings: it runs this script with fixed
# subcommands and literal arguments. This script validates them, resolves the
# APEXREST runtime and prints one JSON line for every data subcommand.
#
# Runtime resolution, first match wins:
#   1. $APEXREST_CLI (the widget's "apexrestCommand" setting): an executable or a .mjs file
#   2. `apexrest` on PATH (npm install -g apexrest)
#   3. the newest runtime bundled with the Claude Code or Codex APEXREST plugin
#
# Settings changes go through `apexrest settings configure` and
# `apexrest sqlcl configure`. Nothing here deploys, imports or writes to a
# database; deployment stays with the coding agent and its APEXREST safeguards.

set -uo pipefail

STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/apexrest-omarchy"
CLI=()
CLI_LABEL=""

usage() {
  cat <<'USAGE'
Usage: apexrest-omarchy <command> [args]

Global status and settings
  which                           Print the resolved APEXREST runtime
  snapshot [project]              Runtime, settings, catalog, SQLcl, previews and the current
                                  (or given) project as one JSON line
  saved-connections               SQLcl saved connections (starts SQLcl, about a second)
  decisions on|off                Default OpenAI Decisions selection (apexrest settings configure)
  catalog on|off                  Reference catalog tools
  sqlcl-mode cli|mcp              SQLcl backend
  sqlcl-transport direct|ords     Database transport (ORDS requires cli mode)
  use-project <project>           Make a project current (read-only project inspect)

Project actions
  preview-start <project> [env]   Start a local (or connected, with env) preview in the background
  preview-stop <port>             Stop the preview on a port
  validate <project>              Oracle compiler validation; also sends a notification
  connection-test <project> <ref> Test a project connection reference (read-only identity query)
  open-url <url>                  Open an http(s) URL in the default browser
  doctor                          Run `apexrest doctor` in a floating terminal
  terminal <project>              Open a terminal in the project folder
  agent <project> [prompt]        Start the default Omarchy coding agent in the project folder
USAGE
}

json_error() {
  jq -cn --arg error "$1" --arg cli "$CLI_LABEL" '{ok:false, cli:(if $cli == "" then null else $cli end), error:$error}'
}

resolve_cli() {
  local candidate
  if [[ -n ${APEXREST_CLI:-} ]]; then
    candidate="${APEXREST_CLI/#\~/$HOME}"
    if [[ $candidate == *.mjs || $candidate == *.js ]]; then
      [[ -f $candidate ]] && CLI=(node "$candidate") && CLI_LABEL="$candidate" && return 0
    elif [[ -x $candidate ]]; then
      CLI=("$candidate") && CLI_LABEL="$candidate" && return 0
    elif command -v "$candidate" >/dev/null 2>&1; then
      CLI=("$candidate") && CLI_LABEL="$(command -v "$candidate")" && return 0
    fi
    return 1
  fi

  if command -v apexrest >/dev/null 2>&1; then
    CLI=(apexrest)
    CLI_LABEL="$(command -v apexrest)"
    return 0
  fi

  command -v node >/dev/null 2>&1 || return 1
  # <cache>/<marketplace>/<plugin>/<version>/runtime/apexrest.mjs, newest version first.
  candidate=$(
    shopt -s nullglob
    for f in "$HOME"/.claude/plugins/cache/*/*/*/runtime/apexrest.mjs \
      "$HOME"/.codex/plugins/cache/*/*/*/runtime/apexrest.mjs; do
      printf '%s\t%s\n' "$(basename "$(dirname "$(dirname "$f")")")" "$f"
    done | sort -t $'\t' -k1,1V | tail -n1 | cut -f2
  )
  if [[ -n $candidate && -f $candidate ]]; then
    CLI=(node "$candidate")
    CLI_LABEL="$candidate"
    return 0
  fi
  return 1
}

require_cli() {
  if ! resolve_cli; then
    json_error "APEXREST runtime not found. Install the APEXREST plugin for Claude Code or Codex, run 'npm install -g apexrest', or set the widget's apexrestCommand."
    exit 3
  fi
}

# Expand a leading ~ and require an absolute APEXREST project folder.
project_arg() {
  local p="${1:-}"
  p="${p/#\~/$HOME}"
  p="${p%/}"
  if [[ -z $p || $p != /* || $p == *$'\n'* || ! -d $p ]]; then
    json_error "Project folder not found: ${1:-<none>}"
    exit 2
  fi
  if [[ ! -f $p/apexrest.json ]]; then
    json_error "No apexrest.json in $p. Run 'apexrest project init' there first."
    exit 2
  fi
  printf '%s' "$p"
}

name_arg() {
  local e="${1:-}"
  if [[ ! $e =~ ^[A-Za-z0-9][A-Za-z0-9_.-]{0,100}$ ]]; then
    json_error "Invalid name: ${e:-<none>}"
    exit 2
  fi
  printf '%s' "$e"
}

choice_arg() {
  local value="${1:-}"
  shift
  local allowed
  for allowed in "$@"; do
    [[ $value == "$allowed" ]] && return 0
  done
  json_error "Expected one of: $*"
  exit 2
}

# Run the CLI with --json and keep only its single JSON result line.
cli_json() {
  local out
  out=$("${CLI[@]}" "$@" --json 2>/dev/null </dev/null | tail -n1)
  if jq -e 'type == "object"' >/dev/null 2>&1 <<<"$out"; then
    printf '%s\n' "$out"
  else
    printf 'null\n'
  fi
}

notify() {
  local glyph="$1" title="$2" body="${3:-}" urgency="${4:-normal}"
  if command -v omarchy-notification-send >/dev/null 2>&1; then
    omarchy-notification-send -g "$glyph" -u "$urgency" "$title" "$body" >/dev/null 2>&1 || true
  elif command -v notify-send >/dev/null 2>&1; then
    notify-send -u "$urgency" "$title" "$body" >/dev/null 2>&1 || true
  fi
}

open_url() {
  local url="$1"
  if [[ ! $url =~ ^https?://[^[:space:]\"\'\<\>]+$ || ${#url} -gt 2048 ]]; then
    json_error "Refusing to open a non-http(s) URL."
    exit 2
  fi
  if command -v omarchy-launch-browser >/dev/null 2>&1; then
    setsid -f omarchy-launch-browser "$url" >/dev/null 2>&1 </dev/null
  else
    setsid -f xdg-open "$url" >/dev/null 2>&1 </dev/null
  fi
  jq -cn --arg url "$url" '{ok:true, url:$url}'
}

project_hash() {
  printf '%s' "$1" | sha256sum | cut -c1-12
}

cmd="${1:-}"
[[ $# -gt 0 ]] && shift

case "$cmd" in
which)
  require_cli
  jq -cn --arg cli "$CLI_LABEL" '{ok:true, cli:$cli}'
  ;;

snapshot)
  require_cli
  tmp=$(mktemp -d)
  trap 'rm -rf "$tmp"' EXIT
  # Independent local reads, in parallel. None of them calls a database or SQLcl.
  cli_json version >"$tmp/version" &
  cli_json settings status >"$tmp/settings" &
  cli_json sqlcl status >"$tmp/sqlcl" &
  cli_json connection list >"$tmp/connections" &
  cli_json preview status >"$tmp/preview" &
  cli_json status --detail doctor >"$tmp/doctor" &
  wait
  # The current project: the widget's pinned folder, else the one APEXREST last worked in.
  project="${1:-}"
  [[ -n $project ]] || project=$(jq -r '.data.recentProjects[0].path // empty' "$tmp/settings" 2>/dev/null)
  printf 'null\n' >"$tmp/project"
  if [[ -n $project ]]; then
    project=$(project_arg "$project") || project=""
    [[ -n $project ]] && cli_json panel status --project "$project" >"$tmp/project"
  fi
  jq -cn --arg cli "$CLI_LABEL" --arg project "$project" \
    --slurpfile version "$tmp/version" --slurpfile settings "$tmp/settings" \
    --slurpfile sqlcl "$tmp/sqlcl" --slurpfile connections "$tmp/connections" \
    --slurpfile preview "$tmp/preview" --slurpfile doctor "$tmp/doctor" \
    --slurpfile current "$tmp/project" \
    '{ok:true, cli:$cli, project:(if $project == "" then null else $project end),
      version:$version[0], settings:$settings[0], sqlcl:$sqlcl[0], connections:$connections[0],
      preview:$preview[0], doctor:$doctor[0], current:$current[0]}'
  ;;

saved-connections)
  require_cli
  cli_json connection list --saved
  ;;

decisions)
  require_cli
  choice_arg "${1:-}" on off || exit 2
  cli_json settings configure --decision-api "$1"
  ;;

catalog)
  require_cli
  choice_arg "${1:-}" on off || exit 2
  cli_json settings configure --catalog "$1"
  ;;

sqlcl-mode)
  require_cli
  choice_arg "${1:-}" cli mcp || exit 2
  cli_json sqlcl configure --mode "$1"
  ;;

sqlcl-transport)
  require_cli
  choice_arg "${1:-}" direct ords || exit 2
  # ORDS needs CLI mode; switching to ORDS selects it in the same step.
  if [[ $1 == ords ]]; then
    cli_json sqlcl configure --mode cli --database-transport ords
  else
    mode=$(cli_json sqlcl status | jq -r '.data.mode // "cli"')
    cli_json sqlcl configure --mode "$mode" --database-transport direct
  fi
  ;;

use-project)
  require_cli
  project=$(project_arg "${1:-}") || { printf '%s\n' "$project"; exit 2; }
  # A successful project operation makes the project current for APEXREST.
  cli_json project inspect --project "$project" --detail summary
  ;;

preview-start)
  require_cli
  project=$(project_arg "${1:-}") || { printf '%s\n' "$project"; exit 2; }
  args=(preview start --project "$project")
  if [[ -n ${2:-} ]]; then
    env=$(name_arg "$2") || { printf '%s\n' "$env"; exit 2; }
    args+=(--env "$env")
  fi
  mkdir -p "$STATE_DIR"
  log="$STATE_DIR/preview-$(project_hash "$project").log"
  # A foreground `preview start` serves until SIGTERM; `preview stop` finds it.
  setsid -f "${CLI[@]}" "${args[@]}" >"$log" 2>&1 </dev/null
  for _ in $(seq 1 90); do
    sleep 0.5
    status=$(cli_json preview status --project "$project")
    if [[ $(jq -r '(.data.running // []) | length' <<<"$status" 2>/dev/null) -gt 0 ]]; then
      url=$(jq -r '.data.running[0].url' <<<"$status")
      notify "󰐊" "APEXREST preview running" "$url" low
      printf '%s\n' "$status"
      exit 0
    fi
    # The preview printed its final JSON and exited: it failed to start.
    if jq -e '.operation == "preview.start" and .ok == false' "$log" >/dev/null 2>&1; then
      break
    fi
  done
  message=$(jq -r '[.diagnostics[]?.message][0] // .summary // empty' "$log" 2>/dev/null | head -n1)
  [[ -n $message ]] || message=$(tail -n3 "$log" 2>/dev/null | tr '\n' ' ')
  notify "󰐊" "APEXREST preview did not start" "${message:-See $log}" critical
  json_error "Preview did not start: ${message:-see $log}"
  exit 1
  ;;

preview-stop)
  require_cli
  port="${1:-}"
  if [[ ! $port =~ ^[0-9]{1,5}$ ]] || ((port < 1 || port > 65535)); then
    json_error "Invalid port: ${port:-<none>}"
    exit 2
  fi
  cli_json preview stop --port "$port"
  ;;

validate)
  require_cli
  project=$(project_arg "${1:-}") || { printf '%s\n' "$project"; exit 2; }
  result=$(cli_json apex validate --project "$project")
  if [[ $result == null ]]; then
    json_error "Validation returned no result."
    notify "󰅚" "APEXREST validation failed" "No result" critical
    exit 1
  fi
  printf '%s\n' "$result"
  if [[ $(jq -r '.ok' <<<"$result") == true ]]; then
    notify "󰄬" "APEXREST validation passed" "$(basename "$project")" low
  else
    errors=$(jq -r '[.diagnostics[]? | select(.severity == "error")] | length' <<<"$result")
    first=$(jq -r '[.diagnostics[]? | select(.severity == "error") | .message][0] // .summary // ""' <<<"$result" |
      grep -m1 -E '^Error:|[^[:space:]]' | sed 's/^Error:[[:space:]]*//' | cut -c1-200)
    notify "󰅚" "APEXREST validation: $errors error(s)" "$first" critical
  fi
  ;;

connection-test)
  require_cli
  project=$(project_arg "${1:-}") || { printf '%s\n' "$project"; exit 2; }
  ref=$(name_arg "${2:-}") || { printf '%s\n' "$ref"; exit 2; }
  result=$(cli_json connection test "$ref" --project "$project")
  printf '%s\n' "$result"
  if [[ $(jq -r '.ok' <<<"$result" 2>/dev/null) == true ]]; then
    notify "󰆼" "Connection $ref works" "$(jq -r '[.data.dbUniqueName // empty, .data.serviceName // empty] | join(" · ")' <<<"$result")" low
  else
    notify "󰆼" "Connection $ref failed" "$(jq -r '[.diagnostics[]?.message][0] // .summary // "No result"' <<<"$result" 2>/dev/null | head -n1)" critical
  fi
  ;;

open-url)
  open_url "${1:-}"
  ;;

doctor)
  require_cli
  printf -v run '%q ' "${CLI[@]}" doctor
  if command -v omarchy-launch-floating-terminal-with-presentation >/dev/null 2>&1; then
    setsid -f omarchy-launch-floating-terminal-with-presentation "$run" >/dev/null 2>&1 </dev/null
  else
    setsid -f xdg-terminal-exec bash -c "$run; read -rp 'Press Enter to close'" >/dev/null 2>&1 </dev/null
  fi
  jq -cn '{ok:true}'
  ;;

terminal)
  project=$(project_arg "${1:-}") || { printf '%s\n' "$project"; exit 2; }
  if command -v uwsm-app >/dev/null 2>&1; then
    setsid -f uwsm-app -- xdg-terminal-exec --dir="$project" >/dev/null 2>&1 </dev/null
  else
    setsid -f xdg-terminal-exec --dir="$project" >/dev/null 2>&1 </dev/null
  fi
  jq -cn '{ok:true}'
  ;;

agent)
  project=$(project_arg "${1:-}") || { printf '%s\n' "$project"; exit 2; }
  prompt="${2:-}"
  if ! command -v omarchy-agent >/dev/null 2>&1; then
    json_error "omarchy-agent not found."
    exit 3
  fi
  if [[ ${#prompt} -gt 2000 ]]; then
    json_error "Prompt is too long."
    exit 2
  fi
  cd "$project" || exit 2
  # omarchy-agent opens its own terminal in the current directory.
  if [[ -n $prompt ]]; then
    setsid -f omarchy-agent --prompt "$prompt" >/dev/null 2>&1 </dev/null
  else
    setsid -f omarchy-agent --pick >/dev/null 2>&1 </dev/null
  fi
  jq -cn '{ok:true}'
  ;;

-h | --help | help | "")
  usage
  ;;

*)
  usage >&2
  exit 2
  ;;
esac
