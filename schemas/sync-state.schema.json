{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "syncId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "projectRoot": {
      "type": "string"
    },
    "projectId": {
      "type": "string"
    },
    "environment": {
      "type": "string"
    },
    "targetDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {}
    },
    "sourceDir": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "toolchainDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runtimeVersion": {
      "type": "string"
    },
    "compilerVersion": {
      "type": "string",
      "minLength": 1
    },
    "exportedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "baseline": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "files": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "directory",
        "files",
        "digest"
      ],
      "additionalProperties": false
    },
    "backup": {
      "type": "object",
      "properties": {
        "backupId": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        "checksum": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "backupId",
        "checksum"
      ],
      "additionalProperties": false
    },
    "observedMetadata": {
      "type": "object",
      "properties": {
        "lastUpdatedOn": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastUpdatedBy": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "lastUpdatedOn",
        "lastUpdatedBy"
      ],
      "additionalProperties": false
    },
    "lastSuccessfulImport": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
            },
            "runId": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            },
            "snapshot": {
              "type": "object",
              "properties": {
                "directory": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "files": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1024
                  },
                  "additionalProperties": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "digest": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "directory",
                "files",
                "digest"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "at",
            "runId",
            "snapshot"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "ready",
        "importing",
        "verification_failed",
        "outcome_unknown",
        "invalidated"
      ]
    },
    "importingRunId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schemaVersion",
    "syncId",
    "revision",
    "projectRoot",
    "projectId",
    "environment",
    "targetDigest",
    "target",
    "sourceDir",
    "toolchainDigest",
    "runtimeVersion",
    "compilerVersion",
    "exportedAt",
    "baseline",
    "backup",
    "observedMetadata",
    "lastSuccessfulImport",
    "status",
    "importingRunId"
  ],
  "additionalProperties": false
}
