  "project": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "project": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "action": {
        "type": "string",
        "enum": [
          "init",
          "adopt",
          "inspect",
          "connection_add",
          "connection_list",
          "connection_test"
        ]
      },
      "directory": {
        "description": "init: new or empty directory for the project",
        "type": "string",
        "minLength": 1
      },
      "template": {
        "type": "string",
        "enum": [
          "blank-app",
          "customer-crm",
          "existing-app"
        ]
      },
      "alias": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,100}$"
      },
      "env": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,100}$"
      },
      "appId": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      },
      "workingCopy": {
        "type": "boolean"
      },
      "detail": {
        "default": "summary",
        "type": "string",
        "enum": [
          "full",
          "summary"
        ]
      },
      "name": {
        "description": "connection reference name",
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,100}$"
      },
      "sqlclName": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512,
        "pattern": "^[^\\x00-\\x1f\\x7f-\\x9f]+$"
      },
      "ordsUrl": {
        "type": "string",
        "maxLength": 2048,
        "format": "uri"
      },
      "ordsUsername": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[^\"\\x00-\\x1f\\x7f-\\x9f]+$"
      },
      "passwordFile": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "saved": {
        "default": false,
        "type": "boolean"
      }
    },
    "required": [
      "action",
      "env"
    ],
    "additionalProperties": false
  },
  "reference": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "project": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4096
      },
      "mode": {
        "type": "string",
        "enum": [
          "search",
          "read"
        ]
      },
      "query": {
        "description": "search: short English/Ukrainian terms",
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "id": {
        "description": "read: result ID, grammar:, component:, pattern:, oracle:",
        "type": "string",
        "maxLength": 200
      },
      "corpus": {
        "default": "apexlang",
        "type": "string",
        "enum": [
          "apexlang",
          "components",
          "patterns",
          "blocks",
          "blueprints"
        ]
      },
      "version": {
        "type": "string"
      },
      "kind": {
        "type": "string",
        "enum": [
          "grammar",
          "template",
          "contract",
          "guide"
        ]
      },
      "family": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      },
      "profile": {
        "type": "string",
        "maxLength": 200
      },
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "experimental",
          "verified",
          "deprecated",
          "revoked"
        ]
      },
      "locale": {
        "type": "string",
        "enum": [
          "en",
          "uk"
        ]
      },
      "cursor": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "offset": {
        "default": 0,
        "type": "integer",
        "minimum": 0,
        "maximum": 10000000
      },
      "limit": {
        "description": "search: 1-8 (default 3); read: characters (default 4096)",
        "type": "integer",
        "minimum": 1,
        "maximum": 8192
      }
    },
    "required": [
      "mode"
    ],
    "additionalProperties": false
  },
