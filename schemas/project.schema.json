{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "projectId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,100}$"
    },
    "application": {
      "type": "object",
      "properties": {
        "sourceDir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "alias": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,100}$"
        }
      },
      "required": [
        "sourceDir",
        "alias"
      ],
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "properties": {
        "migrationsDir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "packagesDir": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      },
      "required": [
        "migrationsDir",
        "packagesDir"
      ],
      "additionalProperties": false
    },
    "toolchain": {
      "type": "object",
      "properties": {
        "lockFile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "profile": {
          "type": "string",
          "enum": [
            "26.1",
            "26.2"
          ]
        }
      },
      "required": [
        "lockFile"
      ],
      "additionalProperties": false
    },
    "environments": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,100}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "development",
              "dev",
              "qa",
              "test",
              "production"
            ]
          },
          "readConnectionRef": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,100}$"
          },
          "deployConnectionRef": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_.-]{0,100}$"
          },
          "workspace": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_$#-]{0,127}$"
          },
          "parsingSchema": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_$#]{0,127}$"
          },
          "applicationId": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "baseUrl": {
            "type": "string",
            "format": "uri"
          },
          "databaseIdentity": {
            "type": "object",
            "properties": {
              "dbUniqueName": {
                "type": "string",
                "minLength": 1
              },
              "serviceName": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "dbUniqueName",
              "serviceName"
            ],
            "additionalProperties": false
          },
          "allowedOrigins": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "format": "uri"
            }
          },
          "expectedMarker": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "readConnectionRef",
          "deployConnectionRef",
          "workspace",
          "parsingSchema",
          "applicationId",
          "baseUrl",
          "databaseIdentity",
          "allowedOrigins"
        ],
        "additionalProperties": false
      }
    },
    "deploymentControl": {
      "type": "string",
      "const": "local"
    },
    "composer": {
      "type": "object",
      "properties": {
        "allowSourceOnly": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "allowSourceOnly"
      ],
      "additionalProperties": false
    },
    "decisionApi": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "apiKeyEnv": {
          "default": "OPENAI_API_KEY",
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "envFile": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "timeoutMs": {
          "default": 3000,
          "type": "integer",
          "minimum": 250,
          "maximum": 10000
        }
      },
      "required": [
        "enabled",
        "apiKeyEnv",
        "timeoutMs"
      ],
      "additionalProperties": false
    },
    "peerReview": {
      "type": "object",
      "properties": {
        "mode": {
          "default": "off",
          "type": "string",
          "enum": [
            "off",
            "advisory",
            "required"
          ]
        },
        "vendor": {
          "default": "auto",
          "type": "string",
          "enum": [
            "auto",
            "codex",
            "claude"
          ]
        },
        "model": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:\\[\\]-]{0,99}$"
        },
        "timeoutSeconds": {
          "default": 600,
          "type": "integer",
          "minimum": 60,
          "maximum": 1800
        }
      },
      "required": [
        "mode",
        "vendor",
        "timeoutSeconds"
      ],
      "additionalProperties": false
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "directory": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        }
      },
      "required": [
        "directory",
        "retentionDays"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "projectId",
    "application",
    "database",
    "toolchain",
    "environments",
    "artifacts"
  ],
  "additionalProperties": false
}
