{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "generatorVersion": {
      "type": "string",
      "const": "1"
    },
    "generationDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "blueprintDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "lockDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "owners": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "instanceId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "blockId": {
            "type": "string",
            "pattern": "^block:[a-z0-9-]+\\/[a-z0-9-]+$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-z0-9.-]+)?$"
          },
          "mode": {
            "type": "string",
            "enum": [
              "managed",
              "extended",
              "detached"
            ]
          },
          "files": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "bases": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024
            },
            "additionalProperties": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "allocation": {
            "type": "object",
            "properties": {
              "page": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              "dialog": {
                "anyOf": [
                  {
                    "type": "integer",
                    "exclusiveMinimum": 0,
                    "maximum": 9007199254740991
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "prefix": {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
              }
            },
            "required": [
              "page",
              "dialog",
              "prefix"
            ],
            "additionalProperties": false
          },
          "consumers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
            }
          },
          "provenance": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "instanceId",
          "blockId",
          "version",
          "mode",
          "files",
          "bases",
          "allocation",
          "consumers",
          "provenance"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "generatorVersion",
    "generationDigest",
    "blueprintDigest",
    "lockDigest",
    "owners"
  ],
  "additionalProperties": false
}
